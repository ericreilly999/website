# Copy to platform.auto.tfvars (gitignored) once Platform delivers the values.
# The placeholders below are NOT real ids; variable validation rejects the account id on purpose.
aws_account_id      = "<WEBSITE_PROD_ACCOUNT_ID>"
dns_zone_id         = "<ERICREILLY_COM_ZONE_ID_FROM_PLATFORM>"
dns_assume_role_arn = "arn:aws:iam::<PLATFORM_ACCOUNT_ID>:role/<RECORD_ROLE_NAME>"

# Contact form SES identities (the mailbox owner clicks the verification links).
contact_to_email   = "<RECIPIENT_ADDRESS>"
contact_from_email = "<SENDER_ADDRESS>"
